  "private": true,
  "dependencies": {
    "@ant-design/icons": "^4.7.0",
    "@auth0/auth0-react": "^2.16.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "@mui/styled-engine-sc": "^6.0.2",
    "@mui/x-charts": "^7.16.0",
    "antd": "^4.21.7",
    "bootstrap": "^5.2.3",
    "dompurify": "^3.3.3",
    "eslint": "^8.22.0",
    "esri-loader": "^3.7.0",
    "papaparse": "^5.4.1",
    "prettier": "^2.7.1",
    "react": "^17.0.2",
    "react-bootstrap": "^2.7.4",
    "react-dom": "^17.0.2",
    "react-router-dom": "^6.3.0",
    "react-scripts": "5.0.1",
    "serve": "^14.2.6"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:watch": "vite build --watch",
    "serve:build": "serve -s build -l 3000",
    "dev:simultaneous": "concurrently \"npm run build:watch\" \"npm run serve:build\"",
    "audit": "node scripts/responsive-audit.mjs",
    "audit:baseline": "OUT=audit/baseline SHOTS=1 node scripts/responsive-audit.mjs",
    "audit:boundary": "MODE=boundary OUT=audit/boundary node scripts/responsive-audit.mjs",
    "audit:diff": "node scripts/audit-compare.mjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "playwright": "^1.63.0",
    "vite": "^8.0.1",
    "vite-plugin-full-reload": "^1.2.0",
    "vite-plugin-svgr": "^4.5.0",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
